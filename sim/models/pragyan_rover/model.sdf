<?xml version="1.0"?>
<sdf version="1.7">
  <model name="pragyan_rover">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- Pragyan-inspired 6-wheel simulation.
         The safety skid is intentionally low so the rover does not fall through
         deep terrain while remaining free to drive over normal slopes. -->

    <link name="base_link">
      <pose>0 0 0.43 0 0 0</pose>
      <inertial>
        <mass>27</mass>
        <inertia>
          <ixx>2.0</ixx><iyy>1.4</iyy><izz>2.2</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.72 0.58 0.22</size></box></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.72 0.58 0.22</size></box></geometry>
      </visual>
    </link>

    <!-- Fixed rocker beams: visually similar to a rocker arrangement,
         but deliberately simplified for stable SIH simulation. -->
    <link name="left_rocker">
      <pose>0 0.34 0.39 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision"><geometry><box><size>0.72 0.08 0.08</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.72 0.08 0.08</size></box></geometry></visual>
    </link>
    <joint name="left_rocker_fixed" type="fixed">
      <parent>base_link</parent><child>left_rocker</child>
    </joint>

    <link name="right_rocker">
      <pose>0 -0.34 0.39 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.08</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision"><geometry><box><size>0.72 0.08 0.08</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.72 0.08 0.08</size></box></geometry></visual>
    </link>
    <joint name="right_rocker_fixed" type="fixed">
      <parent>base_link</parent><child>right_rocker</child>
    </joint>

    <link name="left_front_wheel">
      <pose>0.28 0.39 0.27 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.02</ixx><iyy>0.04</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
        </surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <joint name="left_front_wheel_joint" type="revolute">
      <pose>0.28 0.39 0.27 0 0 0</pose>
      <parent>left_rocker</parent>
      <child>left_front_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>2.0</damping><friction>0.15</friction></dynamics>
      </axis>
    </joint>

    <link name="left_middle_wheel">
      <pose>0.0 0.39 0.27 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.02</ixx><iyy>0.04</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
        </surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <joint name="left_middle_wheel_joint" type="revolute">
      <pose>0.00 0.39 0.27 0 0 0</pose>
      <parent>left_rocker</parent>
      <child>left_middle_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>2.0</damping><friction>0.15</friction></dynamics>
      </axis>
    </joint>

    <link name="left_rear_wheel">
      <pose>-0.28 0.39 0.27 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.02</ixx><iyy>0.04</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
        </surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <joint name="left_rear_wheel_joint" type="revolute">
      <pose>-0.28 0.39 0.27 0 0 0</pose>
      <parent>left_rocker</parent>
      <child>left_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>2.0</damping><friction>0.15</friction></dynamics>
      </axis>
    </joint>

    <link name="right_front_wheel">
      <pose>0.28 -0.39 0.27 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.02</ixx><iyy>0.04</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
        </surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <joint name="right_front_wheel_joint" type="revolute">
      <pose>0.28 -0.39 0.27 0 0 0</pose>
      <parent>right_rocker</parent>
      <child>right_front_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>2.0</damping><friction>0.15</friction></dynamics>
      </axis>
    </joint>

    <link name="right_middle_wheel">
      <pose>0.0 -0.39 0.27 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.02</ixx><iyy>0.04</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
        </surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <joint name="right_middle_wheel_joint" type="revolute">
      <pose>0.00 -0.39 0.27 0 0 0</pose>
      <parent>right_rocker</parent>
      <child>right_middle_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>2.0</damping><friction>0.15</friction></dynamics>
      </axis>
    </joint>

    <link name="right_rear_wheel">
      <pose>-0.28 -0.39 0.27 1.5708 0 0</pose>
      <inertial>
        <mass>0.8</mass>
        <inertia><ixx>0.02</ixx><iyy>0.04</iyy><izz>0.04</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2><slip1>0.0</slip1><slip2>0.0</slip2></ode></friction>
        </surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>0.10</length></cylinder></geometry></visual>
    </link>
    <joint name="right_rear_wheel_joint" type="revolute">
      <pose>-0.28 -0.39 0.27 0 0 0</pose>
      <parent>right_rocker</parent>
      <child>right_rear_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>2.0</damping><friction>0.15</friction></dynamics>
      </axis>
    </joint>

    <!-- Safety belly/skid: catches deep depressions and prevents the rover
         from disappearing into the heightmap. It is intentionally invisible. -->
    <link name="safety_skid">
      <pose>0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="skid_collision">
        <geometry><box><size>0.64 0.50 0.08</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="safety_skid_fixed" type="fixed">
      <parent>base_link</parent><child>safety_skid</child>
    </joint>

    <link name="imu_link">
      <pose>0 0 0.56 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="imu_fixed" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on><update_rate>100</update_rate>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=/imu/data</remapping></ros>
          <frame_name>imu_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <link name="lidar_link">
      <pose>0 0 0.68 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="lidar_fixed" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
    <gazebo reference="lidar_link">
      <sensor name="velodyne_sensor" type="ray">
        <always_on>true</always_on><update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical>
          </scan>
          <range><min>0.15</min><max>30</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="ray_sensor_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=/velodyne_points</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <link name="thermal_camera_link">
      <pose>0.18 0 0.66 0 -0.35 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
    </link>
    <joint name="thermal_camera_fixed" type="fixed"><parent>base_link</parent><child>thermal_camera_link</child></joint>
    <gazebo reference="thermal_camera_link">
      <sensor name="thermal_camera_sensor" type="camera">
        <always_on>true</always_on><update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.0472</horizontal_fov>
          <image><width>320</width><height>240</height><format>L8</format></image>
          <clip><near>0.05</near><far>30</far></clip>
        </camera>
        <plugin name="lunar_thermal_camera_plugin" filename="liblunar_thermal_camera_plugin.so">
          <min_temperature>80</min_temperature><max_temperature>350</max_temperature>
          <noise_sigma>5</noise_sigma><nuc_sigma>1</nuc_sigma>
          <frame_id>thermal_camera_link</frame_id><ground_z>0</ground_z>
        </plugin>
      </sensor>
    </gazebo>

    <link name="left_camera_link">
      <pose>0.18 0.065 0.66 0 -0.35 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <link name="right_camera_link">
      <pose>0.18 -0.065 0.66 0 -0.35 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    </link>
    <joint name="left_camera_fixed" type="fixed"><parent>base_link</parent><child>left_camera_link</child></joint>
    <joint name="right_camera_fixed" type="fixed"><parent>base_link</parent><child>right_camera_link</child></joint>

    <gazebo reference="left_camera_link">
      <sensor name="left_rgb_camera" type="camera">
        <always_on>true</always_on><update_rate>15</update_rate>
        <camera><horizontal_fov>1.0472</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>30</far></clip></camera>
        <plugin name="left_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros><remapping>image_raw:=/camera/left/image_raw</remapping><remapping>camera_info:=/camera/left/camera_info</remapping></ros>
          <frame_name>left_camera_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    <gazebo reference="right_camera_link">
      <sensor name="right_rgb_camera" type="camera">
        <always_on>true</always_on><update_rate>15</update_rate>
        <camera><horizontal_fov>1.0472</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>30</far></clip></camera>
        <plugin name="right_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros><remapping>image_raw:=/camera/right/image_raw</remapping><remapping>camera_info:=/camera/right/camera_info</remapping></ros>
          <frame_name>right_camera_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <!-- Simple stable differential drive: middle wheels are powered.
         Front/rear wheels remain passive but physically connected. -->
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
  <ros>
    <remapping>cmd_vel:=/cmd_vel</remapping>
    <remapping>odom:=/wheel_odom</remapping>
  </ros>

  <update_rate>50</update_rate>

  <left_joint>left_middle_wheel_joint</left_joint>
  <right_joint>right_middle_wheel_joint</right_joint>

  <wheel_separation>0.78</wheel_separation>
  <wheel_diameter>0.28</wheel_diameter>

  <max_wheel_torque>100</max_wheel_torque>
  <max_wheel_acceleration>10</max_wheel_acceleration>

  <command_topic>cmd_vel</command_topic>
  <odometry_topic>wheel_odom</odometry_topic>
  <robot_base_frame>base_link</robot_base_frame>

  <publish_odom>true</publish_odom>
  <publish_tf>true</publish_tf>
  <publish_wheel_tf>false</publish_wheel_tf>
</plugin>

    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=/joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>left_front_wheel_joint</joint_name><joint_name>left_middle_wheel_joint</joint_name><joint_name>left_rear_wheel_joint</joint_name>
      <joint_name>right_front_wheel_joint</joint_name><joint_name>right_middle_wheel_joint</joint_name><joint_name>right_rear_wheel_joint</joint_name>
    </plugin>
  </model>
</sdf>
